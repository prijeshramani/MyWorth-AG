", "source_file": "C:\\Users\\prije\\Downloads\\MyWorth\\backend\\src\\db.ts", "source_location": "L116"}, {"caller_nid": "db_initdb", "callee": "run", "source_file": "C:\\Users\\prije\\Downloads\\MyWorth\\backend\\src\\db.ts", "source_location": "L120"}, {"caller_nid": "db_initdb", "callee": "prepare", "source_file": "C:\\Users\\prije\\Downloads\\MyWorth\\backend\\src\\db.ts", "source_location": "L120"}, {"caller_nid": "db_initdb", "callee": "all", "source_file": "C:\\Users\\prije\\Downloads\\MyWorth\\backend\\src\\db.ts", "source_location": "L136"}, {"caller_nid": "db_initdb", "callee": "prepare", "source_file": "C:\\Users\\prije\\Downloads\\MyWorth\\backend\\src\\db.ts", "source_location": "L136"}, {"caller_nid": "db_initdb", "callee": "some", "source_file": "C:\\Users\\prije\\Downloads\\MyWorth\\backend\\src\\db.ts", "source_location": "L137"}, {"caller_nid": "db_initdb", "callee": "run", "source_file": "C:\\Users\\prije\\Downloads\\MyWorth\\backend\\src\\db.ts", "source_location": "L138"}, {"caller_nid": "db_initdb", "callee": "prepare", "source_file": "C:\\Users\\prije\\Downloads\\MyWorth\\backend\\src\\db.ts", "source_location": "L138"}, {"caller_nid": "db_initdb", "callee": "all", "source_file": "C:\\Users\\prije\\Downloads\\MyWorth\\backend\\src\\db.ts", "source_location": "L142"}, {"caller_nid": "db_initdb", "callee": "prepare", "source_file": "C:\\Users\\prije\\Downloads\\MyWorth\\backend\\src\\db.ts", "source_location": "L142"}, {"caller_nid": "db_initdb", "callee": "some", "source_file": "C:\\Users\\prije\\Downloads\\MyWorth\\backend\\src\\db.ts", "source_location": "L143"}, {"caller_nid": "db_initdb", "callee": "run", "source_file": "C:\\Users\\prije\\Downloads\\MyWorth\\backend\\src\\db.ts", "source_location": "L144"}, {"caller_nid": "db_initdb", "callee": "prepare", "source_file": "C:\\Users\\prije\\Downloads\\MyWorth\\backend\\src\\db.ts", "source_location": "L144"}, {"caller_nid": "db_initdb", "callee": "get", "source_file": "C:\\Users\\prije\\Down