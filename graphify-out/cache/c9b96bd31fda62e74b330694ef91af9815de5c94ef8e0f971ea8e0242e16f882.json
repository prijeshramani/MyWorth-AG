db", "callee": "prepare", "source_file": "C:\\Users\\prije\\Downloads\\MyWorth\\backend\\src\\db.ts", "source_location": "L45"}, {"caller_nid": "db_initdb", "callee": "log", "source_file": "C:\\Users\\prije\\Downloads\\MyWorth\\backend\\src\\db.ts", "source_location": "L47"}, {"caller_nid": "db_initdb", "callee": "db.transaction(() => {\n      db.pragma('foreign_keys = OFF');\n      \n      for (const table of brokenTables) {\n        console.log(`Correcting foreign keys for table: ${table.name}...`);\n        \n        // Rename existing table\n        db.prepare(`ALTER TABLE \"${table.name}\" RENAME TO \"${table.name}_old\"`).run();\n        \n        // Create new table with corrected foreign key pointing to \"assets\"\n        const newSql = table.sql.replace(/REFERENCES\\s+\"assets_old\"/gi, 'REFERENCES assets');\n        db.prepare(newSql).run();\n        \n        // Copy data dynamically\n        const columnsInfo = db.prepare(`PRAGMA table_info(\"${table.name}_old\")`).all() as any[];\n        const colNames = columnsInfo.map(c => `\"${c.name}\"`).join(', ');\n        \n        db.prepare(`\n          INSERT INTO \"${table.name}\" (${colNames})\n          SELECT ${colNames} FROM \"${table.name}_old\"\n        `).run();\n        \n        // Drop old table\n        db.prepare(`DROP TABLE \"${table.name}_old\"`).run();\n      }\n      \n      db.pragma('foreign_keys = ON');\n    })", "source_file": "C:\\Users\\prije\\Downloads\\MyWorth\\backend\\src\\db.ts", "source_location": "L48"}, {"caller_nid": "db_initdb", "callee": "transaction", "source_file": "C:\\Users\\prije\\Downloads\\MyWorth\\backend\\src\\db.ts", "source_location": "L48"}, {"caller_nid": "db_initdb", "callee": "log", "source_file": "C:\\Users\\prije\\Downloads\\MyWorth\\backend\\src\\db.ts", "source_location": "L76"}, {"caller_nid": "db_initdb", "callee": "get", "source_file": "C:\\Users\\prije\\Downloads\\MyWorth\\backend\\src\\db.ts", "source_location": "L80"}, {"caller_nid": "db_initdb", "ca